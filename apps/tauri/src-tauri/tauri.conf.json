{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mrec-tauri",
  "version": "0.1.0",
  "identifier": "dev.meetingrecord.tauri",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "meeting-record (rust)",
        "width": 720,
        "height": 820,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "entitlements.plist"
    }
  }
}
